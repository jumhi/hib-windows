<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HIB.ViewModels"
        x:Class="HIB.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="H.I.B"
        Width="1080" Height="720" MinWidth="820" MinHeight="560"
        Background="{StaticResource HibBg}"
        WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="232,*">
    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{StaticResource HibSidebar}" BorderBrush="{StaticResource HibStroke}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="14,18,14,14">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,0,0,20">
          <Border Width="34" Height="34" CornerRadius="10" ClipToBounds="True">
            <Image Source="{Binding AppIcon}"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="H.I.B" FontSize="17" FontWeight="Bold"/>
            <TextBlock Text="{Binding DesktopName}" Classes="caption" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
          </StackPanel>
        </StackPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding NavItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <Button Classes="nav" Classes.selected="{Binding IsSelected}"
                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectCommand}"
                      CommandParameter="{Binding}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <PathIcon Data="{Binding IconPath}" Width="17" Height="17" Margin="0,0,12,0"
                            Foreground="{Binding $parent[Button].Foreground}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontSize="14"/>
                  <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasBadge}">
                    <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HibOnAccent}" HorizontalAlignment="Center"/>
                  </Border>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding FooterItems}" Margin="0,0,0,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <Button Classes="nav" Classes.selected="{Binding IsSelected}"
                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectCommand}"
                      CommandParameter="{Binding}">
                <Grid ColumnDefinitions="Auto,*">
                  <PathIcon Data="{Binding IconPath}" Width="17" Height="17" Margin="0,0,12,0"
                            Foreground="{Binding $parent[Button].Foreground}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontSize="14"/>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="3" Classes="card" Padding="12,10" CornerRadius="12">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                     Fill="{StaticResource HibMuted}" IsVisible="{Binding !IsConnected}"/>
            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                     Fill="{StaticResource HibGood}" IsVisible="{Binding IsConnected}"/>
            <TextBlock Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Content -->
    <ContentControl Grid.Column="1" Content="{Binding CurrentContent}"/>
  </Grid>
</Window>
