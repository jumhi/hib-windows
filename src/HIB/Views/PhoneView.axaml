<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HIB.ViewModels"
             xmlns:c="using:HIB.Views.Controls"
             x:Class="HIB.Views.PhoneView"
             x:DataType="vm:PhoneViewModel">
  <!-- Settings › Mirroring & ADB -->
  <ScrollViewer Padding="22,0,22,24">
    <StackPanel Spacing="14" MaxWidth="760">
      <c:SectionHeader Title="Mirroring &amp; ADB" IconData="{x:Static vm:Icons.Cast}"/>

      <!-- tools missing -->
      <Border Classes="card warn" IsVisible="{Binding ToolsMissing}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Data="{x:Static vm:Icons.TriangleAlert}" Foreground="{StaticResource HibWarning}"/>
            <TextBlock Text="scrcpy and adb are needed" FontWeight="SemiBold" Foreground="{StaticResource HibWarning}"/>
          </StackPanel>
          <TextBlock Text="{Binding ToolsText}" Classes="caption" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <Border Background="{StaticResource HibFieldFill}" CornerRadius="10" Padding="12,8">
              <SelectableTextBlock Text="{Binding Winget}" Classes="mono"/>
            </Border>
            <Button Grid.Column="1" Classes="primary" Content="Copy" Margin="8,0,0,0" Command="{Binding CopyWingetCommand}"/>
            <Button Grid.Column="2" Content="Check again" Margin="8,0,0,0" Command="{Binding CheckToolsCommand}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ADB -->
      <Border Classes="hero">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Classes="tile" Margin="0,0,14,0">
              <c:Icon Data="{x:Static vm:Icons.Smartphone}"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource HibLime}" BoxShadow="0 0 8 0 #B3BAFF38"
                        VerticalAlignment="Center" IsVisible="{Binding Adb.IsConnected}"/>
                <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource HibFaint}" VerticalAlignment="Center"
                        IsVisible="{Binding !Adb.IsConnected}"/>
                <TextBlock Text="ADB (Wireless debugging)" Classes="headline"/>
              </StackPanel>
              <TextBlock Text="{Binding AdbStatus}" Classes="caption" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Classes="primary" Content="Connect" Command="{Binding ConnectCommand}" IsVisible="{Binding !Adb.IsConnected}"/>
              <Button Content="Disconnect" Command="{Binding DisconnectCommand}" IsVisible="{Binding Adb.IsConnected}"/>
            </StackPanel>
          </Grid>
          <Border Classes="divider"/>
          <Grid ColumnDefinitions="Auto,*,Auto">
            <c:Icon Data="{x:Static vm:Icons.RefreshCw}" Classes="muted" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1" Text="Connect ADB by itself when the phone connects" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <ToggleSwitch Grid.Column="2" IsChecked="{Binding AutoConnect}"/>
          </Grid>
          <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding !Pairing.IsPairing}">
            <c:Icon Data="{x:Static vm:Icons.QrCode}" Classes="muted" Margin="0,0,10,0"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="First time? Pair ADB once"/>
              <TextBlock Text="Developer options › Wireless debugging › Pair device with QR code." Classes="faint" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="2" Content="Pair with ADB QR" Command="{Binding StartPairingCommand}" VerticalAlignment="Center"/>
          </Grid>
          <!-- pairing QR -->
          <Border Classes="glass" CornerRadius="16" Padding="14" IsVisible="{Binding Pairing.IsPairing}">
            <Grid ColumnDefinitions="Auto,*">
              <Border Background="White" CornerRadius="14" Padding="10" Margin="0,0,18,0">
                <Image Source="{Binding PairingQr}" Width="180" Height="180" RenderOptions.BitmapInterpolationMode="None"/>
              </Border>
              <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Pair with ADB QR" Classes="headline"/>
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="On the phone: Settings › Developer options › Wireless debugging › Pair device with QR code, then scan this code."/>
                <TextBlock Text="{Binding Pairing.Status}" TextWrapping="Wrap"/>
                <Button Content="Cancel" Command="{Binding StopPairingCommand}" HorizontalAlignment="Left"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <!-- screen -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*">
            <c:Icon Data="{x:Static vm:Icons.Cast}" Classes="muted" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="Phone screen" FontWeight="SemiBold"/>
              <TextBlock Text="A window you control with mouse and keyboard. Open single apps from the Apps tab." Classes="caption" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
          <WrapPanel>
            <Button Classes="primary" Margin="0,0,8,0" Command="{Binding MirrorScreenCommand}" IsEnabled="{Binding Adb.IsConnected}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{x:Static vm:Icons.Smartphone}" Size="14" StrokeThickness="2.2"/>
                <TextBlock Text="Mirror" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Margin="0,0,8,0" Command="{Binding DesktopModeCommand}" IsEnabled="{Binding Adb.IsConnected}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{x:Static vm:Icons.Monitor}" Size="14"/>
                <TextBlock Text="Desktop" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Content="Close windows" Command="{Binding StopMirroringCommand}" IsVisible="{Binding Mirror.IsMirroring}"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- audio -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <c:Icon Data="{x:Static vm:Icons.Speaker}" Classes="muted" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="Play phone audio here" FontWeight="SemiBold"/>
              <TextBlock Text="Music, videos and calls from the phone come out of this PC's speakers." Classes="caption" TextWrapping="Wrap"/>
            </StackPanel>
            <ToggleSwitch Grid.Column="2" IsChecked="{Binding Audio.IsActive, Mode=OneWay}" Command="{Binding ToggleAudioCommand}"
                          IsEnabled="{Binding Adb.IsConnected}" VerticalAlignment="Top"/>
          </Grid>
          <CheckBox Content="Keep playing on the phone too" IsChecked="{Binding Audio.KeepPlayingOnPhone}" Margin="26,0,0,0"/>
          <TextBlock Text="{Binding Audio.LastError}" IsVisible="{Binding Audio.LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{StaticResource HibDanger}" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Classes="caption" Foreground="{StaticResource HibCyan}" TextWrapping="Wrap" Margin="8,0"/>

      <Border Classes="card" Padding="18,6">
        <Expander HorizontalAlignment="Stretch">
          <Expander.Header>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Data="{x:Static vm:Icons.Terminal}" Classes="muted"/>
              <TextBlock Text="ADB console" VerticalAlignment="Center"/>
            </StackPanel>
          </Expander.Header>
          <Border Background="{StaticResource HibFieldFill}" CornerRadius="12" Padding="12" Margin="0,4,0,10">
            <SelectableTextBlock Text="{Binding Adb.ConsoleLog}" Classes="mono" TextWrapping="Wrap" MaxHeight="280"/>
          </Border>
        </Expander>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
