<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HIB.ViewModels"
             x:Class="HIB.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="Grid.row">
      <Setter Property="Margin" Value="0,6"/>
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel Margin="32,28" Spacing="4" MaxWidth="820">
      <TextBlock Text="Settings" Classes="h1"/>

      <TextBlock Text="NOTIFICATIONS &amp; CALLS" Classes="section"/>
      <Border Classes="card">
        <StackPanel>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Text="Show phone notifications as pop-ups" VerticalAlignment="Center"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotificationToasts}"/>
          </Grid>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Text="Also pop up silent notifications" VerticalAlignment="Center"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding SilentToasts}"/>
          </Grid>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Text="Pop-up duration (seconds)" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1" Value="{Binding ToastSeconds}" Minimum="2" Maximum="60" Increment="1" FormatString="0" Width="130"/>
          </Grid>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Text="Incoming call pop-up with Answer / Decline" VerticalAlignment="Center"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding CallPopups}"/>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="CLIPBOARD &amp; FLICK" Classes="section"/>
      <Border Classes="card">
        <StackPanel>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Text="Sync clipboard" VerticalAlignment="Center"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ClipboardSync}"/>
          </Grid>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Text="Sync clipboard images" VerticalAlignment="Center"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ClipboardImages}"/>
          </Grid>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Text="Open flicked links automatically" VerticalAlignment="Center"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoOpenLinks}"/>
          </Grid>
          <StackPanel Margin="0,10,0,0" Spacing="6">
            <TextBlock Text="Flick with several screens" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding FlickStatus}" Classes="muted" TextWrapping="Wrap" FontSize="12"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button Classes="accent" Content="Teach my screens" Command="{Binding TeachScreensCommand}" IsVisible="{Binding !IsTeaching}"/>
              <Button Classes="soft" Content="Stop teaching" Command="{Binding StopTeachingCommand}" IsVisible="{Binding IsTeaching}"/>
              <Button Classes="soft" Content="Forget screens" Command="{Binding ForgetScreensCommand}"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="STARTUP" Classes="section"/>
      <Border Classes="card">
        <StackPanel>
          <Grid Classes="row" ColumnDefinitions="*,Auto" IsVisible="{Binding AutoStartSupported}">
            <TextBlock Text="Start with Windows" VerticalAlignment="Center"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindows}"/>
          </Grid>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Text="Start minimized to the tray" VerticalAlignment="Center"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartMinimized}"/>
          </Grid>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Text="Closing the window keeps H.I.B running in the tray" VerticalAlignment="Center"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding CloseToTray}"/>
          </Grid>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Let the phone find this PC (mDNS + UDP broadcast)"/>
              <TextBlock Text="Needed for automatic reconnect." Classes="caption"/>
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Discovery}"/>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="THIS COMPUTER" Classes="section"/>
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Name shown on the phone" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding NewName}"/>
            <Button Grid.Column="1" Classes="soft" Content="Rename" Margin="8,0,0,0" Command="{Binding RenameCommand}"/>
          </Grid>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="The phone remembers this computer by name. After renaming, scan the QR again."/>
          <TextBlock Text="{Binding NameStatus}" Classes="muted" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
            <TextBlock Text="{Binding DataDir, StringFormat='Data folder: {0}'}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" Classes="soft" Content="Open" Command="{Binding OpenDataFolderCommand}"/>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="DIAGNOSTICS" Classes="section"/>
      <Border Classes="card" Padding="12">
        <SelectableTextBlock Text="{Binding LogText}" FontFamily="Consolas, Menlo, monospace" FontSize="11.5"
                             Foreground="{StaticResource HibMuted}" TextWrapping="Wrap" MaxHeight="260"/>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
