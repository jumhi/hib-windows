<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HIB.ViewModels"
             xmlns:c="using:HIB.Views.Controls"
             xmlns:pa="using:HIB.Features.PhoneAgent"
             x:Class="HIB.Views.PhoneAgentView"
             x:DataType="vm:PhoneAgentViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="22,0,22,16" MaxWidth="800">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <c:SectionHeader Title="Phone Agent" IconData="{x:Static vm:Icons.Bot}"/>
        <TextBlock Text="Tell it what to do. It works your phone over ADB, step by step." Classes="caption" Margin="8,6,0,0"/>
      </StackPanel>
      <Button Grid.Column="1" Content="Model &amp; key" VerticalAlignment="Center" Command="{Binding ToggleSettingsCommand}"/>
    </Grid>

    <!-- provider / model / key -->
    <Border Grid.Row="1" Classes="card" Margin="0,14,0,0" IsVisible="{Binding ShowSettings}">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
          <TextBlock Text="Provider" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <ComboBox Grid.Column="1" ItemsSource="{Binding ProviderOptions}" SelectedIndex="{Binding ProviderIndex}" HorizontalAlignment="Stretch"/>
          <TextBlock Grid.Column="2" Text="Model" VerticalAlignment="Center" Margin="16,0,10,0" IsVisible="{Binding IsGemini}"/>
          <ComboBox Grid.Column="3" ItemsSource="{Binding ModelOptions}" SelectedIndex="{Binding ModelIndex}" HorizontalAlignment="Stretch" IsVisible="{Binding IsGemini}"/>
          <TextBox Grid.Row="1" Grid.Column="3" Margin="0,8,0,0" Text="{Binding CustomModel}" PlaceholderText="e.g. gemini-3.8-flash" IsVisible="{Binding IsCustomModel}"/>
          <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="Claude Opus · paid API" Classes="muted" VerticalAlignment="Center" Margin="16,0,0,0" IsVisible="{Binding !IsGemini}"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <TextBox Text="{Binding ApiKey}" PasswordChar="•" PlaceholderText="Paste API key"/>
          <Button Grid.Column="1" Classes="primary" Content="Save" Margin="8,0,0,0" Command="{Binding SaveKeyCommand}"/>
          <Button Grid.Column="2" Content="Test" Margin="8,0,0,0" Command="{Binding TestKeyCommand}"/>
          <Button Grid.Column="3" Content="Remove" Margin="8,0,0,0" Command="{Binding RemoveKeyCommand}"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding KeyStatus}" IsVisible="{Binding KeyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Classes="link" Foreground="{StaticResource HibCyan}" Content="{Binding KeyLinkText}" Command="{Binding GetKeyCommand}"/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- prompt -->
    <Border Grid.Row="2" Classes="hero" Margin="0,14,0,0" Padding="16">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Text="{Binding Agent.Prompt}" PlaceholderText="e.g. Open WhatsApp and tell Ali I'll be 10 minutes late"
                   AcceptsReturn="False" TextWrapping="Wrap" MinHeight="44" IsEnabled="{Binding !Agent.IsRunning}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding RunCommand}"/>
            </TextBox.KeyBindings>
          </TextBox>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Top">
            <Button Classes="primary" Content="Run" Command="{Binding RunCommand}" IsEnabled="{Binding Agent.CanRun}" IsVisible="{Binding !Agent.IsRunning}" MinHeight="40"/>
            <Button Classes="danger" Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding Agent.IsRunning}" MinHeight="40"/>
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <c:Icon Data="{x:Static vm:Icons.LoaderCircle}" Size="16" Classes="spin cyan" IsVisible="{Binding Agent.IsRunning}" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding Agent.Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="2" Text="{Binding UsageText}" Classes="caption" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Text="ADB isn't connected. Connect it in Settings › Mirroring &amp; ADB." Foreground="{StaticResource HibWarning}" FontSize="12" IsVisible="{Binding !AdbReady}"/>
        <TextBlock Text="Add an API key under Model &amp; key (Gemini has a free tier)." Foreground="{StaticResource HibWarning}" FontSize="12" IsVisible="{Binding !Agent.HasApiKey}"/>
      </StackPanel>
    </Border>

    <!-- timeline -->
    <Panel Grid.Row="3" Margin="0,14,0,0">
      <TextBlock Text="Steps will appear here with a screenshot after each action." Classes="muted" IsVisible="{Binding !HasSteps}"/>
      <ScrollViewer IsVisible="{Binding HasSteps}">
        <ItemsControl ItemsSource="{Binding Agent.Steps}" Margin="0,0,8,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="pa:PhoneAgentStep">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                <Border Width="4" CornerRadius="2" Margin="0,2,12,2" Background="{Binding Kind, Converter={x:Static vm:StepKindBrushConverter.Instance}}"/>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Top">
                  <TextBlock Text="{Binding Kind, Converter={x:Static vm:StepKindText.Label}}" FontSize="10.5" FontWeight="Bold" LetterSpacing="1"
                             Foreground="{Binding Kind, Converter={x:Static vm:StepKindBrushConverter.Instance}}"/>
                  <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Detail, Converter={x:Static vm:StepKindText.NotEmpty}}"/>
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="8" ClipToBounds="True" Margin="12,0,0,0" MaxHeight="110" MaxWidth="64"
                        IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <Image Source="{Binding Thumbnail, Converter={x:Static vm:BytesToBitmapConverter.Instance}}" Stretch="Uniform"/>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>

    <!-- question / confirmation bars -->
    <StackPanel Grid.Row="4" Spacing="10" Margin="0,10,0,0">
      <Border Classes="card warn" IsVisible="{Binding HasQuestion}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Agent.PendingQuestion}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBox Text="{Binding Answer}" PlaceholderText="Your answer…">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SendAnswerCommand}"/>
              </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Classes="primary" Content="Answer" Margin="8,0,0,0" Command="{Binding SendAnswerCommand}"/>
            <Button Grid.Column="2" Content="Skip" Margin="8,0,0,0" Command="{Binding SkipQuestionCommand}"/>
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="card warn" IsVisible="{Binding HasConfirmation}">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel>
            <TextBlock Text="Approve this step?" Foreground="{StaticResource HibWarning}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Agent.PendingConfirmation}" TextWrapping="Wrap"/>
          </StackPanel>
          <Button Grid.Column="1" Classes="primary" Content="Approve" Margin="12,0,0,0" VerticalAlignment="Center" Command="{Binding ApproveCommand}"/>
          <Button Grid.Column="2" Classes="danger" Content="Cancel" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding DenyCommand}"/>
        </Grid>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
