<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HIB.ViewModels"
             x:Class="HIB.Views.FindMyView"
             x:DataType="vm:FindMyViewModel">
  <ScrollViewer>
    <StackPanel Margin="32,28" Spacing="14" MaxWidth="900">
      <TextBlock Text="Find My" Classes="h1"/>
      <Border Classes="hero">
        <Grid ColumnDefinitions="Auto,*">
          <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource HibAccentSoft}" Margin="0,0,20,0" VerticalAlignment="Top">
            <PathIcon Width="30" Height="30" Foreground="{StaticResource HibAccentBrush}"
                      Data="M12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5M12,2A7,7 0 0,0 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9A7,7 0 0,0 12,2Z"/>
          </Border>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{Binding RouteText}" Classes="h2" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding FindMy.Status}" Classes="muted" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,10,0,0">
              <Button Classes="accent" Content="{Binding RingLabel}" Margin="0,0,8,8" Command="{Binding ToggleRingCommand}"/>
              <Button Classes="soft" Content="Locate" Margin="0,0,8,8" Command="{Binding LocateCommand}"/>
              <Button Classes="danger" Content="Lock phone" Margin="0,0,8,8" Command="{Binding LockCommand}"/>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,16,*">
        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Text="Last known location" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding LocationText}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding LocationDetail}" Classes="muted" TextWrapping="Wrap"/>
            <Button Classes="soft" Content="Open in Maps" HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding OpenMapCommand}" IsEnabled="{Binding HasLocation}"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="Show a message on the phone" FontWeight="SemiBold"/>
            <TextBox Text="{Binding MessageText}" PlaceholderText="If found, please call…" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxLength="500"/>
            <Button Classes="accent" Content="Show message" HorizontalAlignment="Left" Command="{Binding ShowMessageCommand}"/>
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="card">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="Internet relay" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding RelayText}" Classes="muted" TextWrapping="Wrap" FontSize="12"/>
            <TextBlock Text="{Binding FindMy.RelayTestResult}" TextWrapping="Wrap" FontSize="12"/>
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="When the phone is away, commands travel end-to-end encrypted through ntfy.sh using a key derived from your pairing key."/>
          </StackPanel>
          <Button Grid.Column="1" Classes="soft" Content="Test relay" VerticalAlignment="Top" Margin="12,0,0,0" Command="{Binding TestRelayCommand}"/>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
