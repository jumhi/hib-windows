<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HIB.ViewModels"
             xmlns:core="using:HIB.Core.Phone"
             xmlns:c="using:HIB.Views.Controls"
             x:Class="HIB.Views.FilesView"
             x:DataType="vm:FilesViewModel">
  <!-- Settings › Files: send to a device, and what arrived -->
  <ScrollViewer Padding="22,0,22,24">
    <StackPanel Spacing="14" MaxWidth="760">
      <c:SectionHeader Title="Files" IconData="{x:Static vm:Icons.Folder}"/>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Classes="tile" Margin="0,0,14,0">
              <c:Icon Data="{x:Static vm:Icons.Share}"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
              <TextBlock Text="Send to…" Classes="headline"/>
              <TextBlock Text="{Binding SendHint}" Classes="caption" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="2" Classes="primary" VerticalAlignment="Center" Margin="12,0,0,0" Command="{Binding ChooseFilesCommand}" IsEnabled="{Binding CanSend}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{x:Static vm:Icons.Share}" Size="14" StrokeThickness="2.2"/>
                <TextBlock Text="Choose files…" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
          <ListBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" Background="Transparent" IsVisible="{Binding CanSend}">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="CornerRadius" Value="999"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,8,6"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:SendTarget">
                <Border Classes="chip" Padding="12,5">
                  <TextBlock Text="{Binding Label}" FontSize="12.5"/>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,Auto" Margin="8,4,0,0">
        <StackPanel Spacing="2">
          <TextBlock Text="RECEIVED" Classes="label"/>
          <TextBlock Text="{Binding DownloadsPath, StringFormat='Saved in {0}. Drag a file into any app.'}" Classes="faint" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Column="1" Command="{Binding OpenDownloadsCommand}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Data="{x:Static vm:Icons.FolderOpen}" Size="14"/>
            <TextBlock Text="Open folder" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
      <TextBlock Text="Nothing received yet. Flick something from your phone." Classes="caption" Margin="8,0,0,0" IsVisible="{Binding IsEmpty}"/>
      <ItemsControl ItemsSource="{Binding Transfers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TransferItemViewModel">
            <Border Classes="card" Margin="0,0,0,8" Padding="14,12">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <ProgressBar Value="{Binding Percent}" Maximum="100" Height="5"/>
                <TextBlock Text="{Binding Detail}" Classes="faint"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding Files}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FileItemViewModel">
            <Border Classes="card" Margin="0,0,0,8" Padding="14,10" Cursor="Hand"
                    PointerPressed="OnCardPressed" PointerMoved="OnCardMoved" ToolTip.Tip="Drag into Explorer, WhatsApp, Outlook…">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource HibCyanSoft}" Margin="0,0,12,0">
                  <c:Icon Data="{x:Static vm:Icons.FileText}" Size="18" Classes="cyan" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Detail}" Classes="faint"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Classes="primary" Content="Open" Padding="12,5" Command="{Binding OpenCommand}"/>
                  <Button Classes="icon" ToolTip.Tip="Show in folder" Command="{Binding RevealCommand}">
                    <c:Icon Data="{x:Static vm:Icons.FolderOpen}" Size="14"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
