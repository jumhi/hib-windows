<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HIB.ViewModels"
             xmlns:c="using:HIB.Views.Controls"
             x:Class="HIB.Views.PairView"
             x:DataType="vm:PairViewModel">
  <!-- The Mac's ScannerView + QRScannerSidebarView: "Scan to connect", the QR on black, nearby phones -->
  <ScrollViewer Padding="22,0,22,24">
    <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0">
      <!-- QR card -->
      <Border Classes="panel glow" Width="320" Padding="22,20" Margin="0,0,18,18" VerticalAlignment="Top">
        <StackPanel Spacing="14">
          <TextBlock Text="Scan to connect" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
          <Border Background="Black" CornerRadius="30" Padding="16" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #59000000">
            <Border Background="White" CornerRadius="14" Padding="8">
              <Image Source="{Binding QrImage}" Width="196" Height="196" RenderOptions.BitmapInterpolationMode="None"/>
            </Border>
          </Border>
          <TextBlock Text="{Binding ConnectionStatus}" Classes="caption" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
          <WrapPanel HorizontalAlignment="Center">
            <Border Classes="chip" Margin="0,0,6,6">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <c:Icon Data="{x:Static vm:Icons.Monitor}" Size="12" Classes="cyan" StrokeThickness="2.2"/>
                <TextBlock Text="{Binding DesktopName}" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>
            <Border Classes="chip" Margin="0,0,6,6">
              <TextBlock Text="{Binding Port, StringFormat='Port {0}'}"/>
            </Border>
          </WrapPanel>
          <!-- server status + actions (Ready ⚙) -->
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Border Classes="chip lime" Padding="11,6" IsVisible="{Binding IsReady}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{x:Static vm:Icons.CircleCheck}" Size="14" Foreground="{StaticResource HibLime}"/>
                <TextBlock Text="{Binding ServerText}" FontSize="12.5"/>
              </StackPanel>
            </Border>
            <Border Classes="chip" Padding="11,6" IsVisible="{Binding !IsReady}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{x:Static vm:Icons.TriangleAlert}" Size="14" Foreground="{StaticResource HibWarning}"/>
                <TextBlock Text="{Binding ServerText}" FontSize="12.5"/>
              </StackPanel>
            </Border>
            <Button Classes="icon" ToolTip.Tip="Copy the pairing code" Command="{Binding CopyCodeCommand}">
              <c:Icon Data="{x:Static vm:Icons.KeyRound}" Size="15"/>
            </Button>
            <Button Classes="icon" ToolTip.Tip="Refresh the code" Command="{Binding RefreshCommand}">
              <c:Icon Data="{x:Static vm:Icons.RefreshCw}" Size="15"/>
            </Button>
          </StackPanel>
          <TextBlock Text="{Binding Status}" Classes="caption" Foreground="{StaticResource HibCyan}" HorizontalAlignment="Center"
                     TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding HasStatus}"/>
        </StackPanel>
      </Border>

      <!-- nearby phones + how to + advanced -->
      <StackPanel Width="360" Spacing="14" Margin="0,0,0,18">
        <Border Classes="panel" Padding="18,16">
          <StackPanel Spacing="12">
            <TextBlock Text="AVAILABLE DEVICES" Classes="label"/>
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding NoPhones}">
              <c:Icon Data="{x:Static vm:Icons.LoaderCircle}" Size="16" Classes="spin cyan" VerticalAlignment="Center"/>
              <TextBlock Text="Looking for devices…" Classes="caption" VerticalAlignment="Center"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Phones}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DiscoveredPhoneItem">
                  <Border Classes="glass" CornerRadius="16" Padding="12,10" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource HibCyanSoft}" Margin="0,0,10,0">
                        <c:Icon Data="{x:Static vm:Icons.Smartphone}" Size="18" Classes="cyan" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Ips}" Classes="faint" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <Button Grid.Column="2" Classes="primary" Content="Connect" Padding="12,5" FontSize="12.5"
                              Command="{Binding $parent[ItemsControl].((vm:PairViewModel)DataContext).ConnectToCommand}" CommandParameter="{Binding}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="panel" Padding="18,16">
          <StackPanel Spacing="10">
            <TextBlock Text="HOW TO PAIR" Classes="label"/>
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
              <Border Classes="badge" Margin="0,1,10,8"><TextBlock Text="1"/></Border>
              <TextBlock Grid.Column="1" Text="Open H.I.B on your phone." TextWrapping="Wrap" Margin="0,0,0,8"/>
              <Border Grid.Row="1" Classes="badge" Margin="0,1,10,8"><TextBlock Text="2"/></Border>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="Tap Scan and point the camera at this code." TextWrapping="Wrap" Margin="0,0,0,8"/>
              <Border Grid.Row="2" Classes="badge" Margin="0,1,10,0"><TextBlock Text="3"/></Border>
              <TextBlock Grid.Row="2" Grid.Column="1" Text="Keep both on the same Wi-Fi. They reconnect by themselves after that." TextWrapping="Wrap"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="panel" Padding="18,6">
          <Expander Header="Advanced" HorizontalAlignment="Stretch">
            <StackPanel Spacing="10" Margin="0,4,0,8">
              <TextBlock Text="This computer's addresses" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Addresses}" Classes="caption" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding DiscoveryMode}" Classes="faint"/>
              <WrapPanel>
                <Button Content="Ask phone to connect" Margin="0,0,8,8" Command="{Binding WakeCommand}"/>
                <Button Content="Show code text" Margin="0,0,8,8" Command="{Binding ToggleQrTextCommand}"/>
                <Button Content="Allow through firewall" Margin="0,0,8,8" Command="{Binding AddFirewallRuleCommand}" IsVisible="{Binding FirewallSupported}"/>
              </WrapPanel>
              <SelectableTextBlock Text="{Binding QrText}" Classes="mono" TextWrapping="Wrap" IsVisible="{Binding ShowQrText}"/>
              <Border Classes="divider"/>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="New pairing key" FontWeight="SemiBold"/>
                  <TextBlock Classes="caption" TextWrapping="Wrap" Text="Every phone has to scan the new code."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0,0,0">
                  <Button Classes="danger" Content="Reset…" Command="{Binding AskResetCommand}" IsVisible="{Binding !ConfirmReset}"/>
                  <Button Content="Cancel" Command="{Binding CancelResetCommand}" IsVisible="{Binding ConfirmReset}"/>
                  <Button Classes="danger" Content="Yes, reset" Command="{Binding ResetCommand}" IsVisible="{Binding ConfirmReset}"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Expander>
        </Border>
      </StackPanel>
    </WrapPanel>
  </ScrollViewer>
</UserControl>
