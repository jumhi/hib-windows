<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HIB.ViewModels"
        xmlns:c="using:HIB.Views.Controls"
        x:Class="HIB.Views.SetupWindow"
        x:DataType="vm:SetupViewModel"
        Title="H.I.B Setup"
        Width="540" Height="420" CanResize="False"
        Background="{StaticResource HibInk}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        WindowStartupLocation="CenterScreen">

  <!-- Setup / uninstall in the Mac H.I.B look: ambient navy, glass card, cyan button, lime for "done". -->
  <Panel>
    <c:AmbientBackground/>
    <Border x:Name="TitleStrip" Height="36" VerticalAlignment="Top" Background="Transparent"/>

    <Grid RowDefinitions="Auto,*,Auto" Margin="30,46,30,26">
      <!-- header: icon, title, version -->
      <Grid ColumnDefinitions="Auto,*">
        <Border Width="66" Height="66" CornerRadius="17" ClipToBounds="True" BoxShadow="0 10 34 0 #3320D9FF">
          <Image Source="{Binding AppIcon}" Stretch="UniformToFill"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="{Binding Title}" FontSize="23" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Subtitle}" Classes="caption" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>

      <Panel Grid.Row="1" Margin="0,22,0,0">
        <!-- install: where it goes + desktop shortcut -->
        <Border Classes="card" VerticalAlignment="Top" IsVisible="{Binding ShowInstallOptions}">
          <StackPanel Spacing="12">
            <TextBlock Text="INSTALLS TO" Classes="label"/>
            <Grid ColumnDefinitions="Auto,*">
              <c:Icon Data="{x:Static vm:Icons.Folder}" Classes="cyan" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding InstallDir}" Classes="mono" TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" ToolTip.Tip="{Binding InstallDir}"/>
            </Grid>
            <Border Classes="divider"/>
            <CheckBox IsChecked="{Binding DesktopShortcut}" Content="Put H.I.B on the desktop too"/>
            <Grid ColumnDefinitions="Auto,*">
              <c:Icon Data="{x:Static vm:Icons.ShieldCheck}" Classes="muted" Size="15" Margin="0,0,9,0" VerticalAlignment="Top"/>
              <TextBlock Grid.Column="1" Classes="faint" TextWrapping="Wrap"
                         Text="Just for you, no administrator needed. Adds H.I.B to Start and to Settings › Apps, so you can uninstall it like any app."/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- uninstall: what goes + keep data -->
        <Border Classes="card" VerticalAlignment="Top" IsVisible="{Binding ShowUninstallOptions}">
          <StackPanel Spacing="12">
            <TextBlock Text="REMOVES" Classes="label"/>
            <TextBlock TextWrapping="Wrap" Classes="muted"
                       Text="The app, its Start menu and desktop shortcuts, the H.I.B entries in Explorer's Send to menu and Start with Windows."/>
            <Border Classes="divider"/>
            <CheckBox IsChecked="{Binding DeleteData}" Content="Also delete my settings and pairings"/>
            <TextBlock Classes="faint" TextWrapping="Wrap"
                       Text="Leave this off to keep this PC paired with your devices if you install H.I.B again. Files you received stay in Downloads."/>
          </StackPanel>
        </Border>

        <!-- working -->
        <Border Classes="card" VerticalAlignment="Top" IsVisible="{Binding IsWorking}">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Classes="spin cyan" Data="{x:Static vm:Icons.LoaderCircle}" Size="16"/>
              <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
            </StackPanel>
            <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="6" CornerRadius="3"/>
            <TextBlock Text="{Binding InstallDir}" Classes="mono" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Border>

        <!-- done -->
        <Border Classes="card" VerticalAlignment="Top" IsVisible="{Binding IsDone}">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="40" Height="40" CornerRadius="999" Background="{StaticResource HibLimeSoft}" BorderBrush="#59BAFF38"
                    BorderThickness="0.8" Margin="0,0,14,0" VerticalAlignment="Top">
              <c:Icon Data="{x:Static vm:Icons.Check}" Foreground="{StaticResource HibLime}" Size="20"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Text="{Binding DoneTitle}" Classes="headline"/>
              <TextBlock Text="{Binding DoneBody}" Classes="caption" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- failed -->
        <Border Classes="card warn" VerticalAlignment="Top" IsVisible="{Binding IsFailed}">
          <Grid ColumnDefinitions="Auto,*">
            <c:Icon Data="{x:Static vm:Icons.TriangleAlert}" Foreground="{StaticResource HibWarning}" Size="20" Margin="0,0,12,0" VerticalAlignment="Top"/>
            <SelectableTextBlock Grid.Column="1" Text="{Binding Error}" TextWrapping="Wrap"/>
          </Grid>
        </Border>
      </Panel>

      <!-- buttons -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
        <Button Content="{Binding SecondaryText}" Command="{Binding SecondaryCommand}" IsVisible="{Binding ShowSecondary}" MinWidth="92"
                HorizontalContentAlignment="Center"/>
        <Button Classes="danger" Content="Uninstall" Command="{Binding UninstallCommand}" IsVisible="{Binding ShowDanger}" MinWidth="110"
                HorizontalContentAlignment="Center"/>
        <Button Classes="primary" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" IsVisible="{Binding ShowPrimary}"
                MinWidth="110" HorizontalContentAlignment="Center" IsDefault="True"/>
      </StackPanel>
    </Grid>
  </Panel>
</Window>
