<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HIB.ViewModels"
             x:Class="HIB.Views.SearchPhoneView"
             x:DataType="vm:SearchPhoneViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="32,28,32,0">
    <TextBlock Text="Search phone" Classes="h1"/>
    <Border Grid.Row="1" Classes="hero" Margin="0,14,0,0" Padding="16">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Text="{Binding Query}" PlaceholderText="pdf from last week, Mom, boarding pass…" MinHeight="40">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="1" Classes="accent" Content="Search" Margin="10,0,0,0" MinHeight="40" Command="{Binding SearchCommand}"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <CheckBox Content="Photos" IsChecked="{Binding Photos}"/>
          <CheckBox Content="Files" IsChecked="{Binding Files}"/>
          <CheckBox Content="Apps" IsChecked="{Binding Apps}"/>
          <CheckBox Content="Contacts" IsChecked="{Binding Contacts}"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,8">
      <ProgressBar IsIndeterminate="True" Width="80" Height="4" IsVisible="{Binding IsSearching}" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Status}" Classes="muted"/>
    </StackPanel>
    <ScrollViewer Grid.Row="3">
      <ItemsControl ItemsSource="{Binding Results}" Margin="0,0,8,24">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SearchResultItem">
            <Border Classes="card" Margin="0,0,0,8" Padding="12">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="52" Height="52" CornerRadius="10" ClipToBounds="True" Background="{StaticResource HibAccentSoft}" Margin="0,0,14,0">
                  <Panel>
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}"/>
                    <TextBlock Text="{Binding KindLabel}" FontSize="9" FontWeight="Bold" IsVisible="{Binding !HasThumbnail}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource HibAccentBrush}"/>
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Subtitle}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Detail}" Classes="caption"/>
                  <ProgressBar Value="{Binding Progress}" Height="4" Margin="0,4,0,0" IsVisible="{Binding IsDownloading}"/>
                  <TextBlock Text="{Binding Status}" Classes="caption"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="accent" Content="Download" Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}" IsEnabled="{Binding !IsDownloading}"/>
                  <Button Classes="soft" Content="Open" Command="{Binding OpenCommand}" IsVisible="{Binding IsSaved}"/>
                  <Button Classes="soft" Content="Show in folder" Command="{Binding RevealCommand}" IsVisible="{Binding IsSaved}"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
