<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HIB.ViewModels"
             xmlns:c="using:HIB.Views.Controls"
             x:Class="HIB.Views.AboutView"
             x:DataType="vm:AboutViewModel">
  <ScrollViewer Padding="22,0,22,24">
    <StackPanel Spacing="14" MaxWidth="760">
      <c:SectionHeader Title="About" IconData="{x:Static vm:Icons.Info}"/>
      <Border Classes="hero" Padding="28">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <Border Width="104" Height="104" CornerRadius="26" ClipToBounds="True" HorizontalAlignment="Center">
            <Image Source="{Binding Icon}"/>
          </Border>
          <TextBlock Text="H.I.B" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
          <TextBlock Text="Your phone and your computers, as one." Classes="muted" HorizontalAlignment="Center"/>
          <Border Classes="chip cyan" HorizontalAlignment="Center" Margin="0,6,0,0" Padding="12,4">
            <TextBlock Text="{Binding Maker}" FontWeight="SemiBold" Foreground="{StaticResource HibCyan}"/>
          </Border>
          <TextBlock Text="{Binding Version}" Classes="caption" HorizontalAlignment="Center" Margin="0,8,0,0"/>
          <TextBlock Text="{Binding Platform}" Classes="faint" HorizontalAlignment="Center"/>
          <TextBlock Text="Works with the H.I.B Android app and H.I.B for Mac." Classes="faint" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
