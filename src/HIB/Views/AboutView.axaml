<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HIB.ViewModels"
             x:Class="HIB.Views.AboutView"
             x:DataType="vm:AboutViewModel">
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
    <Border Width="112" Height="112" CornerRadius="28" ClipToBounds="True" HorizontalAlignment="Center">
      <Image Source="{Binding Icon}"/>
    </Border>
    <TextBlock Text="H.I.B" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
    <TextBlock Text="Your Android phone, on your PC." Classes="muted" HorizontalAlignment="Center"/>
    <Border Classes="pill" HorizontalAlignment="Center" Margin="0,6,0,0">
      <TextBlock Text="{Binding Maker}" FontWeight="SemiBold" Foreground="{StaticResource HibAccentBrush}"/>
    </Border>
    <TextBlock Text="{Binding Version}" Classes="caption" HorizontalAlignment="Center" Margin="0,8,0,0"/>
    <TextBlock Text="{Binding Platform}" Classes="caption" HorizontalAlignment="Center"/>
    <TextBlock Text="Works with the H.I.B Android app (an AirSync fork)." Classes="caption" HorizontalAlignment="Center"/>
  </StackPanel>
</UserControl>
