<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HIB.ViewModels"
             xmlns:cr="using:HIB.Features.CallRelay"
             x:Class="HIB.Views.CallsView"
             x:DataType="vm:CallsViewModel">
  <ScrollViewer>
    <StackPanel Margin="32,28" Spacing="14" MaxWidth="960">
      <TextBlock Text="Calls" Classes="h1"/>
      <TextBlock Text="Make, answer and end phone calls from this PC, and hear the call on the PC's speakers or headphones." Classes="muted" TextWrapping="Wrap"/>

      <!-- dialer -->
      <Border Classes="hero">
        <StackPanel Spacing="10">
          <TextBlock Text="Dial" Classes="h2"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding Number}" PlaceholderText="Phone number" FontSize="18" MaxLength="60"/>
            <Button Grid.Column="1" Classes="accent" Content="Call" Margin="8,0,0,0" MinWidth="90" Command="{Binding CallCommand}" IsEnabled="{Binding CanCall}" IsDefault="True"/>
          </Grid>
          <CheckBox Content="Hear this call on this PC" IsChecked="{Binding HearThisCall}"/>
          <TextBox Text="{Binding ContactQuery}" PlaceholderText="Search contacts…"/>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding Calls.IsLoadingContacts}" Height="3"/>
          <ItemsControl ItemsSource="{Binding Calls.Contacts}" IsVisible="{Binding HasContacts}" MaxHeight="300">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="cr:PhoneContact">
                <Button Classes="nav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,2"
                        Command="{Binding $parent[ItemsControl].((vm:CallsViewModel)DataContext).PickContactCommand}" CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding Number}" Classes="muted" Margin="12,0,0,0"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Calls.Status}" Classes="muted" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- control + audio -->
      <Grid ColumnDefinitions="*,16,*">
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="Current call" Classes="h2"/>
            <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12"
                       Text="Uses the H.I.B link when it's connected, otherwise ADB. &quot;Answer here&quot; answers and plays the call on this PC."/>
            <WrapPanel IsEnabled="{Binding CanControl}">
              <Button Classes="accent" Content="Answer here" Margin="0,0,8,8" Command="{Binding AnswerHereCommand}"/>
              <Button Classes="soft" Content="Answer" Margin="0,0,8,8" Command="{Binding AnswerCommand}"/>
              <Button Classes="soft" Content="Decline" Margin="0,0,8,8" Command="{Binding DeclineCommand}"/>
              <Button Classes="danger" Content="End call" Margin="0,0,8,8" Command="{Binding EndCommand}"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="Hear calls on this PC" Classes="h2"/>
                <TextBlock Text="Starts automatically when a call is answered or placed, stops when it ends." Classes="muted" TextWrapping="Wrap" FontSize="12"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoHear}" VerticalAlignment="Top"/>
            </Grid>
            <TextBlock Text="{Binding AudioStatus}" TextWrapping="Wrap"/>
            <Button Classes="soft" Content="{Binding AudioButton}" HorizontalAlignment="Left" Command="{Binding ToggleAudioCommand}" IsEnabled="{Binding Adb.IsConnected}"/>
            <TextBlock Text="{Binding Audio.LastError}" Foreground="{StaticResource HibDanger}" TextWrapping="Wrap" FontSize="12"/>
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Text="Talking" FontWeight="SemiBold"/>
          <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12"
                     Text="Speak into the phone: the call uses the phone's microphone. Android has no way to switch a call to speakerphone from a computer without root, so tap Speaker on the phone for hands-free."/>
          <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12"
                     Text="For a full two-way call through this PC's microphone and speakers, pair the PC with the phone over Bluetooth and use Windows Phone Link (Calls), which uses the Bluetooth hands-free profile."/>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="Placing calls and call audio need ADB (Wireless debugging)."/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
