<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HIB.ViewModels"
             xmlns:c="using:HIB.Views.Controls"
             x:Class="HIB.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <!-- The Mac's SidebarView: linked phone card, phone mockup (PhoneView/ScreenView), Mirror ▾ / Desktop ▾ -->
  <UserControl.Resources>
    <LinearGradientBrush x:Key="PhoneFallback" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#22346B" Offset="0"/>
      <GradientStop Color="#152052" Offset="0.55"/>
      <GradientStop Color="#0C1433" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="PhoneGlowCyan" Center="85%,12%" GradientOrigin="85%,12%" RadiusX="70%" RadiusY="45%">
      <GradientStop Color="#5520D9FF" Offset="0"/>
      <GradientStop Color="#0020D9FF" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="PhoneGlowLavender" Center="10%,90%" GradientOrigin="10%,90%" RadiusX="75%" RadiusY="40%">
      <GradientStop Color="#307A6BFF" Offset="0"/>
      <GradientStop Color="#007A6BFF" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="ScreenShade" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#59000000" Offset="0"/>
      <GradientStop Color="#0D000000" Offset="1"/>
    </LinearGradientBrush>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.frost.quick">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.frost.round">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.split">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.split:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1AFFFFFF"/>
    </Style>
    <Style Selector="c|Icon.white">
      <Setter Property="Foreground" Value="White"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="0,40,0,0">
    <!-- ===== LINKED GALAXY ===== -->
    <Border Classes="panel glow" CornerRadius="18" Padding="10" Margin="14,4,14,0">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource HibCyanSoft}">
            <TextBlock Text="H" FontSize="19" FontWeight="Bold" Foreground="{StaticResource HibCyan}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="LINKED GALAXY" Classes="label" FontSize="9"/>
            <TextBlock Text="{Binding ShortName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding DeviceName}"/>
          </StackPanel>
          <!-- HIBStatusMark -->
          <Panel Grid.Column="2" Width="28" Height="28" ToolTip.Tip="{Binding ConnectionText}">
            <Ellipse Fill="#2EBAFF38" IsVisible="{Binding IsConnected}"/>
            <Ellipse Fill="#14FFFFFF" IsVisible="{Binding !IsConnected}"/>
            <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource HibLime}"
                    BoxShadow="0 0 10 1 #CCBAFF38" IsVisible="{Binding IsConnected}"/>
            <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource HibMuted}" IsVisible="{Binding !IsConnected}"/>
          </Panel>
        </Grid>
        <!-- other computers online right now -->
        <ItemsControl ItemsSource="{Binding OtherDevices}" IsVisible="{Binding HasOtherDevices}" Margin="2,0,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DeviceChip">
              <Button Classes="bare" Padding="0" Margin="0,0,6,4" ToolTip.Tip="{Binding Tip}"
                      Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).OpenDevicesCommand}">
                <Border Classes="chip" Padding="7,3">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <c:Icon Data="{Binding IconPath}" Size="12" Classes="cyan" StrokeThickness="2.2"/>
                    <TextBlock Text="{Binding Name}" FontSize="11" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                    <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource HibLime}"
                            VerticalAlignment="Center" IsVisible="{Binding InUse}"/>
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- ===== phone mockup ===== -->
    <Panel Grid.Row="1" Width="226" MaxHeight="476" Margin="0,14,0,8" HorizontalAlignment="Center">
      <Border CornerRadius="26" Background="#111533" BoxShadow="0 9 48 0 #2620D9FF"/>
      <Border CornerRadius="26" ClipToBounds="True">
        <Panel>
          <!-- wallpaper (album art while music plays) -->
          <Border Background="{StaticResource PhoneFallback}"/>
          <Border Background="{StaticResource PhoneGlowCyan}"/>
          <Border Background="{StaticResource PhoneGlowLavender}"/>
          <Image Source="{Binding ScreenImage}" Stretch="UniformToFill" IsVisible="{Binding HasScreenImage}"/>
          <Border Background="{StaticResource ScreenShade}"/>

          <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="8,10,8,8">
            <!-- ConnectionStatusPill -->
            <Button Classes="bare" Padding="0" HorizontalAlignment="Center" ToolTip.Tip="Connection">
              <Border Classes="frost" Padding="11,6">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <c:Icon Data="{x:Static vm:Icons.Wifi}" Size="15" Classes="white" StrokeThickness="2.2" IsVisible="{Binding IsConnected}"/>
                  <c:Icon Data="{x:Static vm:Icons.Globe}" Size="15" Classes="white" StrokeThickness="2.2" Opacity="0.55" IsVisible="{Binding !IsConnected}"/>
                  <c:Icon Data="{x:Static vm:Icons.Smartphone}" Size="15" Classes="white" StrokeThickness="2.2" IsVisible="{Binding IsAdbConnected}"/>
                  <c:Icon Data="{Binding AdbModeIcon}" Size="15" Classes="white" StrokeThickness="2.2" IsVisible="{Binding IsAdbConnected}"/>
                  <c:Icon Data="{x:Static vm:Icons.Speaker}" Size="15" Classes="white" StrokeThickness="2.2" IsVisible="{Binding IsAudioHere}"/>
                  <c:Icon Data="{x:Static vm:Icons.MonitorDown}" Size="15" Classes="white" StrokeThickness="2.2"/>
                </StackPanel>
              </Border>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Spacing="10" Width="290">
                    <Grid ColumnDefinitions="Auto,*">
                      <c:Icon Data="{x:Static vm:Icons.Smartphone}" Size="16" Classes="cyan" Margin="0,0,10,0"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding LinkText}" Classes="caption" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasFeatures}">
                      <c:Icon Data="{Binding AdbModeIcon}" Size="16" Classes="cyan" Margin="0,0,10,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding AdbText}" Classes="caption" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                      <c:Icon Data="{x:Static vm:Icons.MonitorDown}" Size="16" Classes="cyan" Margin="0,0,10,0"/>
                      <TextBlock Grid.Column="1" Text="Ready to receive files and Flicks" Classes="caption" VerticalAlignment="Center"/>
                    </Grid>
                    <WrapPanel HorizontalAlignment="Center" Margin="0,4,0,0">
                      <Button Content="ADB" Margin="0,0,8,0" Command="{Binding ToggleAdbCommand}" IsVisible="{Binding HasFeatures}" ToolTip.Tip="Connect or disconnect ADB"/>
                      <Button Content="Reconnect" Margin="0,0,8,0" Command="{Binding ReconnectCommand}" IsVisible="{Binding !IsConnected}"/>
                      <Button Classes="primary" Content="Disconnect" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}"/>
                    </WrapPanel>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>

            <!-- not connected: like ConnectionStateView -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,0" Spacing="6"
                        IsVisible="{Binding !IsConnected}">
              <Border Classes="frost" Padding="10,5" HorizontalAlignment="Center">
                <TextBlock Text="{Binding ConnectionText}" FontSize="11.5" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
              </Border>
              <Button Classes="frost" Content="Reconnect" HorizontalAlignment="Center" Padding="12,4" FontSize="12"
                      Command="{Binding ReconnectCommand}"/>
            </StackPanel>

            <!-- TimeView: stacked when the music card is hidden -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2" IsVisible="{Binding ClockStacked}">
              <c:GlassText Text="{Binding Hour}" FontSize="96" Spacing="-5" HorizontalAlignment="Center"/>
              <c:GlassText Text="{Binding Minute}" FontSize="96" Spacing="-5" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        IsVisible="{Binding !ClockStacked}">
              <c:GlassText Text="{Binding Hour}" FontSize="58" Spacing="-3"/>
              <c:GlassText Text="{Binding Minute}" FontSize="58" Spacing="-3"/>
            </StackPanel>

            <!-- RecentAppsGridView -->
            <ItemsControl Grid.Row="3" ItemsSource="{Binding RecentApps}" Opacity="{Binding ScreenOpacity}" HorizontalAlignment="Center" Margin="0,6,0,8">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PhoneAppItem">
                  <Button Classes="bare" Padding="0" Width="38" Height="38" CornerRadius="11" ToolTip.Tip="{Binding Name}"
                          Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).OpenAppCommand}" CommandParameter="{Binding}">
                    <Border Width="36" Height="36" CornerRadius="10" ClipToBounds="True" Background="#33FFFFFF">
                      <Panel>
                        <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}"/>
                        <TextBlock Text="{Binding Initial}" IsVisible="{Binding !HasIcon}" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Panel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- quick actions: send, files, mute, clipboard -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="{Binding ScreenOpacity}">
              <Button Classes="frost quick" ToolTip.Tip="Send files to the phone" Command="{Binding SendFilesCommand}">
                <c:Icon Data="{x:Static vm:Icons.Share}" Size="16"/>
              </Button>
              <Button Classes="frost quick" ToolTip.Tip="Files" Command="{Binding OpenFilesCommand}">
                <c:Icon Data="{x:Static vm:Icons.Folder}" Size="16"/>
              </Button>
              <Button Classes="frost quick" Classes.on="{Binding IsSilenced}" ToolTip.Tip="{Binding SilenceTip}" Command="{Binding ToggleSilenceCommand}">
                <c:Icon Data="{Binding SilenceIcon}" Size="16"/>
              </Button>
              <Button Classes="frost quick" ToolTip.Tip="Send this PC's clipboard to the phone" Command="{Binding SendClipboardCommand}">
                <c:Icon Data="{x:Static vm:Icons.Clipboard}" Size="16"/>
              </Button>
            </StackPanel>

            <!-- DeviceStatusView: music card + battery / volume / music -->
            <Border Grid.Row="5" Classes="frost" CornerRadius="20" Padding="4" HorizontalAlignment="Center" Opacity="{Binding ScreenOpacity}">
              <StackPanel Spacing="4">
                <!-- MediaPlayerView -->
                <StackPanel Spacing="5" Margin="8,8,8,4" Width="176" IsVisible="{Binding MusicCardVisible}">
                  <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                    <c:Icon Data="{x:Static vm:Icons.ListMusic}" Size="12" Classes="white"/>
                    <TextBlock Text="{Binding MediaTitle}" FontSize="12" FontWeight="SemiBold" Foreground="White"
                               TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                  </StackPanel>
                  <TextBlock Text="{Binding MediaArtist}" FontSize="11" Foreground="#CCFFFFFF" HorizontalAlignment="Center"
                             TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                  <StackPanel Spacing="1" IsVisible="{Binding HasDuration}">
                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" MinHeight="4" MinWidth="0" Margin="2,0" Foreground="White" Background="#33FFFFFF"/>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Elapsed}" FontSize="9.5" Foreground="#B3FFFFFF" FontFamily="Cascadia Mono, Consolas, Menlo, monospace"/>
                      <TextBlock Grid.Column="1" Text="{Binding Duration}" FontSize="9.5" Foreground="#B3FFFFFF" FontFamily="Cascadia Mono, Consolas, Menlo, monospace"/>
                    </Grid>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Classes="frost round" ToolTip.Tip="Previous" Command="{Binding PreviousCommand}">
                      <c:Icon Data="{x:Static vm:Icons.SkipBack}" Size="14"/>
                    </Button>
                    <Button Classes="primary" Width="40" Height="30" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            ToolTip.Tip="Play / pause" Command="{Binding PlayPauseCommand}">
                      <c:Icon Data="{Binding PlayPauseIcon}" Size="15" StrokeThickness="2.4"/>
                    </Button>
                    <Button Classes="frost round" ToolTip.Tip="Next" Command="{Binding NextCommand}">
                      <c:Icon Data="{x:Static vm:Icons.SkipForward}" Size="14"/>
                    </Button>
                  </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="5" Margin="8,0,2,0" VerticalAlignment="Center" ToolTip.Tip="{Binding BatteryText}">
                    <c:Icon Data="{Binding BatteryIcon}" Size="17" Classes="white"/>
                    <TextBlock Text="{Binding BatteryPercent}" FontSize="11.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                  </StackPanel>
                  <Button Classes="frost round" Width="46" ToolTip.Tip="{Binding VolumeText}">
                    <c:Icon Data="{Binding VolumeIcon}" Size="15"/>
                    <Button.Flyout>
                      <Flyout Placement="Top">
                        <StackPanel Width="220" Spacing="8">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <c:Icon Data="{x:Static vm:Icons.Volume}" Size="15" Classes="muted"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Margin="8,0"
                                    Value="{Binding VolumeValue}"/>
                            <c:Icon Grid.Column="2" Data="{x:Static vm:Icons.Volume2}" Size="15" Classes="muted"/>
                          </Grid>
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding VolumeText, StringFormat='Phone volume · {0}'}" Classes="caption" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Mute" Padding="10,4" FontSize="12" Command="{Binding ToggleMuteCommand}"/>
                          </Grid>
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                  <Button Classes="frost round" Width="46" Classes.on="{Binding MusicCardVisible}" ToolTip.Tip="Show or hide the player"
                          Command="{Binding ToggleMusicCardCommand}" IsVisible="{Binding HasMedia}">
                    <c:Icon Data="{Binding MusicToggleIcon}" Size="15"/>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Panel>
      </Border>
      <Border CornerRadius="26" BorderBrush="{StaticResource HibPhoneStroke}" BorderThickness="1" IsHitTestVisible="False"/>
    </Panel>

    <!-- ===== Mirror ▾ / Desktop ▾ ===== -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,4,0,14"
                IsVisible="{Binding HasFeatures}">
      <Border Classes="glass" CornerRadius="19" Background="#1CFFFFFF">
        <StackPanel Orientation="Horizontal">
          <Button Classes="split" Padding="14,0,10,0" CornerRadius="19,0,0,19" Command="{Binding MirrorCommand}" ToolTip.Tip="Show the phone screen in a window">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <c:Icon Data="{x:Static vm:Icons.Smartphone}" Size="16"/>
              <TextBlock Text="{Binding MirrorLabel}" FontSize="13.5" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Border Width="1" Background="#26FFFFFF" Margin="0,10"/>
          <Button Classes="split" Padding="8,0,11,0" CornerRadius="0,19,19,0" ToolTip.Tip="More">
            <c:Icon Data="{x:Static vm:Icons.ChevronDown}" Size="14"/>
            <Button.Flyout>
              <MenuFlyout Placement="TopEdgeAlignedLeft">
                <MenuItem Header="Mirror screen" Command="{Binding MirrorCommand}"/>
                <MenuItem Header="Open an app…" Command="{Binding OpenAppsCommand}"/>
                <MenuItem Header="Play phone audio here" Command="{Binding ToggleAudioHereCommand}"/>
                <MenuItem Header="Close mirror windows" Command="{Binding StopMirroringCommand}"/>
                <MenuItem Header="Mirroring settings…" Command="{Binding OpenMirrorSettingsCommand}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Border>
      <Border Classes="glass" CornerRadius="19" Background="#1CFFFFFF">
        <StackPanel Orientation="Horizontal">
          <Button Classes="split" Padding="14,0,10,0" CornerRadius="19,0,0,19" Command="{Binding DesktopCommand}" ToolTip.Tip="Phone desktop mode in a window">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <c:Icon Data="{x:Static vm:Icons.Monitor}" Size="16"/>
              <TextBlock Text="{Binding DesktopLabel}" FontSize="13.5" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Border Width="1" Background="#26FFFFFF" Margin="0,10"/>
          <Button Classes="split" Padding="8,0,11,0" CornerRadius="0,19,19,0" ToolTip.Tip="More">
            <c:Icon Data="{x:Static vm:Icons.ChevronDown}" Size="14"/>
            <Button.Flyout>
              <MenuFlyout Placement="TopEdgeAlignedRight">
                <MenuItem Header="Desktop mode" Command="{Binding DesktopCommand}"/>
                <MenuItem Header="Close desktop windows" Command="{Binding StopMirroringCommand}"/>
                <MenuItem Header="Mirroring settings…" Command="{Binding OpenMirrorSettingsCommand}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
