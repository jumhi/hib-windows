<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:HIB.Services"
        x:Class="HIB.Views.ToastWindow"
        x:DataType="s:ToastViewModel"
        Width="372"
        SizeToContent="Height"
        WindowDecorations="None"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Title="H.I.B">
  <Border Classes="toast" Margin="2">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">
      <!-- header: icon, caption, close -->
      <Border Grid.Row="0" Grid.Column="0" Width="22" Height="22" CornerRadius="6" ClipToBounds="True"
              Margin="0,0,8,0" IsVisible="{Binding HasIcon}">
        <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
      </Border>
      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Caption}" Classes="caption" VerticalAlignment="Center"/>
      <Button Grid.Row="0" Grid.Column="2" Classes="icon-btn" Command="{Binding DismissCommand}" ToolTip.Tip="Dismiss">
        <PathIcon Width="10" Height="10" Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
      </Button>

      <!-- content -->
      <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" Margin="0,8,0,0" Background="Transparent"
            Cursor="Hand" PointerPressed="OnContentPressed" PointerMoved="OnContentMoved" PointerReleased="OnContentClicked">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Title}" Classes="toast-title" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Body}" Classes="toast-body" TextWrapping="Wrap" MaxLines="4"
                     TextTrimming="CharacterEllipsis" IsVisible="{Binding HasBody}"/>
        </StackPanel>
        <Border Grid.Column="1" Width="64" Height="64" CornerRadius="10" ClipToBounds="True" Margin="10,0,0,0"
                IsVisible="{Binding HasImage}">
          <Image Source="{Binding Image}" Stretch="UniformToFill"/>
        </Border>
      </Grid>

      <!-- inline reply -->
      <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" Margin="0,10,0,0" IsVisible="{Binding HasReply}">
        <TextBox Text="{Binding ReplyText}" PlaceholderText="{Binding ReplyPlaceholder}" Classes="reply">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SendReplyCommand}"/>
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" Classes="accent" Margin="6,0,0,0" Command="{Binding SendReplyCommand}">Send</Button>
      </Grid>

      <!-- action buttons -->
      <ItemsControl Grid.Row="3" Grid.ColumnSpan="3" ItemsSource="{Binding Buttons}" Margin="0,10,0,0"
                    IsVisible="{Binding HasButtons}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="s:ToastButton">
            <Button Content="{Binding Label}" Command="{Binding Command}" Margin="0,0,6,4"
                    Classes.accent="{Binding IsPrimary}" Classes.danger="{Binding IsDanger}" Classes.soft="{Binding IsNeutral}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Border>
</Window>
