<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets/hib.ico</ApplicationIcon>
    <AssemblyName>HIB</AssemblyName>
    <RootNamespace>HIB</RootNamespace>
    <Product>H.I.B</Product>
    <Company>Haitham Hamid</Company>
    <Authors>Haitham Hamid</Authors>
    <Copyright>Made by Haitham Hamid</Copyright>
    <Version>1.6.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Single-file publish: extract native libs (Skia/HarfBuzz) next to the exe at first run. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HIB.FakePhone" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HIB.Features\HIB.Features.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- adb.exe, scrcpy.exe + DLLs (the official scrcpy win64 zip), overridable with -p:HibToolsDir=… -->
    <HibToolsDir Condition="'$(HibToolsDir)' == ''">$(MSBuildProjectDirectory)\..\..\tools\win-x64</HibToolsDir>
  </PropertyGroup>

  <!-- Portable build: the tools in HibToolsDir are copied to <publish>/tools next to HIB.exe (never
       embedded in the single file). AdbLocator looks there first. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' And '$(HibSetup)' != 'true' And Exists('$(HibToolsDir)')">
    <None Include="$(HibToolsDir)\**\*" Link="tools\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- Setup build (-p:HibSetup=true → H.I.B-Setup.exe): the same app with the tools embedded as one zip
       resource. Started as *Setup*.exe it installs itself to %LOCALAPPDATA%\Programs\H.I.B (Core/Install).
       Its own obj/bin folders, so a later portable build never reuses a DLL that carries the zip. -->
  <PropertyGroup Condition="'$(HibSetup)' == 'true'">
    <IntermediateOutputPath>obj\setup\$(Configuration)\</IntermediateOutputPath>
    <OutputPath>bin\setup\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <Target Name="HibEmbedTools" BeforeTargets="BeforeBuild" Condition="'$(HibSetup)' == 'true'">
    <Error Condition="!Exists('$(HibToolsDir)')" Text="HibSetup needs adb/scrcpy in $(HibToolsDir) (unzip the official scrcpy win64 release there)." />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ZipDirectory SourceDirectory="$(HibToolsDir)" DestinationFile="$(IntermediateOutputPath)hib-tools.zip" Overwrite="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)hib-tools.zip" LogicalName="HIB.Tools.zip" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="QRCoder" Version="1.9.0" />
    <!-- Phone Remote on Windows (SPACE.md §15): DXGI Desktop Duplication, D3D11 video processor, Media Foundation H.264. MIT. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

  <!-- Keep the publish folder to the exe (+ tools): no managed or native .pdb files. -->
  <Target Name="HibDropPdbsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
